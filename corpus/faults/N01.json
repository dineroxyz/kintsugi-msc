{
  "id": "N01",
  "title": "Empty-cart tax divides by zero units",
  "pattern": "off-by-context-divzero",
  "provenance": {
    "origin": "mined",
    "source": "https://github.com/django/django/commit/d058058976496cedf3f36fa303a0327af38cdeaa",
    "upstream_repo": "django/django",
    "upstream_commit": "Fixed #37191 -- Prevented ValueError in FileBasedCache.touch() for expired keys.",
    "failure_class_upstream": "ValueError",
    "modeled_on": "an operation valid for the normal case divides by a quantity that can be zero"
  },
  "service": "alpha",
  "deterministic": true,
  "stateful": true,
  "mutations": [
    {
      "file": "alpha/main.py",
      "find": "            \"per_unit_tax\": round(base and (base * rate_pct / 100) / base, 4)}\n",
      "replace": "            \"per_unit_tax\": round((base * rate_pct / 100) / base, 4)}\n"
    }
  ],
  "setup": [
    {
      "method": "POST",
      "path": "/carts/c1/items",
      "json": {
        "sku": "WIDGET",
        "quantity": 0
      }
    }
  ],
  "trigger": {
    "method": "GET",
    "path": "/carts/c1/tax"
  },
  "expected_exception": "ZeroDivisionError",
  "expected_c3": "refused",
  "notes": "stateful: needs a cart of zero-quantity items"
}
