{
  "id": "M17",
  "title": "Reserved unit decoded as if it were bytes",
  "pattern": "bytes-str-compat-drift",
  "provenance": {
    "origin": "mined",
    "source": "https://github.com/celery/celery/commit/8f0842b336bb95b38e436ca0739e9646ac016ae4",
    "upstream_repo": "celery/celery",
    "upstream_commit": "fix(redis): keep _reconnect_pubsub compatible with redis-py < 5.3.0 (#10298)",
    "failure_class_upstream": "TypeError",
    "modeled_on": "client library version drift changes the value type a call site assumes"
  },
  "service": "alpha",
  "deterministic": true,
  "stateful": false,
  "mutations": [
    {
      "file": "alpha/main.py",
      "find": "    return {\"sku\": sku, \"unit\": unit}\n",
      "replace": "    return {\"sku\": sku, \"unit\": unit.decode()}\n"
    }
  ],
  "trigger": {
    "method": "POST",
    "path": "/reserve/WIDGET"
  },
  "expected_exception": "AttributeError",
  "expected_c3": "healed"
}
