# Kintsugi hosted demo: the real Mealie application, unmodified, behind the supervisor.
FROM python:3.14-slim
RUN apt-get update && apt-get install -y --no-install-recommends git build-essential libldap2-dev libsasl2-dev && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy
COPY pristine /app/pristine
WORKDIR /app/pristine
RUN uv sync --frozen --no-install-project && uv pip install --python /opt/venv/bin/python anthropic
WORKDIR /app
COPY kintsugi /app/kintsugi
COPY supervisor.py demo.json fault.diff /app/
ENV PATH=/opt/venv/bin:$PATH KINTSUGI_DEMO_ROOT=/app KINTSUGI_DATA=/data PYTHONUNBUFFERED=1 DATA_DIR=/data/mealie
CMD ["sh", "-c", "uvicorn supervisor:app --host 0.0.0.0 --port ${PORT:-8080}"]
